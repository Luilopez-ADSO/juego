{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jugar Cyber Drift (Chrome)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Jugar Cyber Drift (Edge)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Chrome con Servidor Local (Puerto 5000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5000/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}